{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@agent-chat/contracts": ["packages/contracts/src/index.ts"]
    },
    "declaration": false,
    "sourceMap": false
  },
  "include": ["tests/**/*.ts", "tests/**/*.tsx", "src/**/*.ts", "vitest.config.ts", "playwright.config.ts", "playwright.managed.config.ts", "playwright.cloud.config.ts"]
}
